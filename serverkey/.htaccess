<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route V3 encrypted API first (before blocking direct access to legacy /api/*.php)
    RewriteRule ^api/v3/?$ api_v2.php?action=v3 [QSA,L]
    RewriteRule ^api/ci/register/?$ api_v2.php?action=ci_register_build [QSA,L]

    # Deny access to dotfiles, backups, SQL, JSON, logs, Composer/Rust/git internals & legacy /api/*.php
    RewriteRule ^(\.env|\.git|\.htaccess|composer\.(json|lock)|schema_addon\.sql) - [F,L]
    RewriteRule ^(data|lib|api)/ - [F,L]
    RewriteRule \.(json|sql|bak|old|orig|zip|tar|gz|log|lock|md)$ - [F,L,NC]

    # Allow real safe entry files (admin.php, api_v2.php, index.php, assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

<FilesMatch "(^\.|(\.(json|sql|env|bak|old|zip|log|lock|sh|py|rs|toml)$))">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
